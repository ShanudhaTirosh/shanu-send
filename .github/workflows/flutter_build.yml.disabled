name: Flutter ShanuSend Build Matrix

# Disabled: all builds run locally
on: []

jobs:
  build:
    name: Build Flutter App on ${{ matrix.os }}
    runs-on: ${{ matrix.os }}
    strategy:
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    steps:
      - uses: actions/checkout@v4

      - name: Set up Java JDK
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Set up Flutter SDK
        uses: subosito/flutter-action@v2
        with:
          channel: 'stable'
          cache: true

      - name: Enable Desktop Targets
        run: |
          flutter config --enable-windows-desktop
          flutter config --enable-macos-desktop
          flutter config --enable-linux-desktop

      - name: Install Dependencies
        run: |
          cd flutter_app
          flutter pub get

      - name: Analyze Code
        run: |
          cd flutter_app
          flutter analyze

      - name: Build Android APK (on Ubuntu)
        if: matrix.os == 'ubuntu-latest'
        run: |
          cd flutter_app
          flutter build apk --release --no-tree-shake-icons

      - name: Build Windows Executable (on Windows)
        if: matrix.os == 'windows-latest'
        run: |
          cd flutter_app
          flutter build windows --release

      - name: Build macOS Application (on macOS)
        if: matrix.os == 'macos-latest'
        run: |
          cd flutter_app
          flutter build macos --release
