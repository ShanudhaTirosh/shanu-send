{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShanuSend",
  "version": "2.5.3",
  "identifier": "lk.zarcon.shanusend",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShanuSend",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
